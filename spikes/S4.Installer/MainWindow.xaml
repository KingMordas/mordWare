<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="S4.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="Info" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Pick folder" Click="OnPickFolder" />
            <Button Content="Write test file" Click="OnWriteTestFile" />
            <Button Content="Check for updates" Click="OnCheckForUpdates" />
        </StackPanel>
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
    </StackPanel>
</Window>
