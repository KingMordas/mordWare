# Normalize line endings in the repository; check out with the platform default.
* text=auto

# Windows-only formats keep CRLF in the working tree.
*.sln      text eol=crlf
*.slnx     text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.xaml     text eol=crlf
*.resw     text eol=crlf
*.appxmanifest text eol=crlf

# Git hooks are run by sh, which needs LF even on a Windows checkout.
.githooks/* text eol=lf

# Binary assets.
*.png  binary
*.ico  binary
*.pfx  binary
