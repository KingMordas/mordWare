<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="S3.Storage.PickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="mordWare S3 spike">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="S3 spike: folder picker check (e)" />
        <TextBlock x:Name="FolderText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PickButton" Click="OnPick" Content="Pick folder" />
            <Button x:Name="WriteButton" Click="OnWrite" Content="Write test file" />
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
</Window>
