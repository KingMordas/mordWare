<Project Sdk="Microsoft.NET.Sdk">

  <!-- S4 installer spike (roadmap [S4], change spike-unpackaged-installer). Throwaway: NOT in MordWare.slnx,
       not named MordWare.* (the architecture tests never load it), referenced by nothing.
       An UNPACKAGED WinUI 3 probe app, installed and updated by Velopack under its own packIds
       (MordWare.Spike.S4 for Release, MordWare.Spike.S4.Dev for every other configuration), never
       MordWare or MordWare.Dev. Driven from outside by run-checks.ps1 (design D1, D5). [D] deletes it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>S4.Installer</RootNamespace>
    <AssemblyName>S4Probe</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <IsPackable>false</IsPackable>

    <!-- Unpackaged, everything bundled (design D1). -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Must stay true even unpackaged: without it, dotnet publish drops the app's own .pri (with the
         compiled XAML) and the installed app crashes in Microsoft.UI.Xaml.dll on its first window. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- Velopack's hooks must run before any UI: our own Main (design D2). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Binary public safety (design D7): no build-machine paths in the output. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Edition fixed by the build, never at runtime (design D4, guardrail 7). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MORDWARE_PROD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
